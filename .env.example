# ─── Base de datos ────────────────────────────────────────────────────────────
# Neon, Supabase, Render Postgres, o el que sea. Postgres 14+.
# Neon: copiá la "Pooled connection string".
DATABASE_URL="postgresql://usuario:clave@host/vitaldesk_lite?sslmode=require"

# ─── Sesiones ─────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Generá uno con:  openssl rand -base64 32
AUTH_SECRET=""

# URL pública de la app. Se usa en los links que van dentro de los correos.
APP_URL="https://citas.tuclinica.com"

# ─── Correo (SMTP) ────────────────────────────────────────────────────────────
# Sin esto la app NO manda correos: los imprime en la consola del servidor.
# Sirve cualquier SMTP: Resend, Brevo, Mailgun, SendGrid, Gmail con app password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Tu Clínica <citas@tuclinica.com>"

# ─── Demo ─────────────────────────────────────────────────────────────────────
# "true" muestra el código de 6 dígitos en pantalla, para probar sin correo.
# Se apaga solo apenas configurás SMTP_HOST.
# ⚠️  En producción con pacientes reales: dejalo en "false".
SHOW_DEV_CODE="false"
